extends layout

block content
  // TELA 3: O ESTUDO PROFUNDO (Foco no Verso)
  // O data-context alimenta a inteligência de Lucce 4.0
  section.molecule-verse-detail(data-context=`Capítulo ${verso.capitulo_numero}, Verso ${verso.verso_numero}`)
    
    header.atom-verse-navigation
      a.atom-btn-back(href=`/capitulo/${verso.capitulo_numero}`) 
        svg(viewBox="0 0 24 24" width="18")
          path(d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" fill="currentColor")
        span Voltar ao Capítulo
      
      .atom-verse-id
        span.label-v BG
        span.value-v #{verso.capitulo_numero}.#{verso.verso_numero}

    article.organism-shastra-content
      // O Sânscrito: A vibração primordial
      section.molecule-sanskrit-area
        h2.atom-text-sanskrit= verso.sanskrito_original
        p.atom-text-transliteration= verso.transliteracao
      
      hr.atom-divider-vajra

      // A Ponte: Tradução palavra por palavra (se disponível) e Tradução fluida
      section.molecule-translation-area
        if verso.sinonimos
          p.atom-text-synonyms= verso.sinonimos
        
        p.atom-text-translation= verso.traducao_completa

      // A Profundidade: O Significado (Purport)
      if verso.significado
        section.molecule-purport-area
          h3.atom-subtitle-purport Significado
          .atom-content-purport!= verso.significado

    footer.atom-verse-footer
      p.status-meta Documento extraído via Crawler V1.0 - Sincronizado com MongoDB.